{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["google-apps-script", "node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
