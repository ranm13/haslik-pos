{
  "name": "haslik-pos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "קופת הסליק – PWA על GitHub Pages + Apps Script JSON API",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p backend/tsconfig.json --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "build:backend": "node backend/build.mjs",
    "push:backend": "npm run build:backend && cd backend && clasp push --force",
    "dev": "vite --config frontend/vite.config.ts",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts",
    "it:staging": "node backend/integration/run.mjs"
  },
  "devDependencies": {
    "@types/google-apps-script": "1.0.83",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "esbuild": "0.24.0",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.0",
    "vitest": "2.1.5"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
