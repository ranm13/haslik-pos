{
  "name": "haslik-pos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "HaSlik pub POS – Google Apps Script web app (TypeScript, clasp)",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node build.mjs",
    "push": "npm run build && clasp push --force"
  },
  "devDependencies": {
    "@types/google-apps-script": "1.0.83",
    "@types/node": "22.9.0",
    "esbuild": "0.24.0",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
